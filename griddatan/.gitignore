# Fitted/predictor artifacts can get large (triangulations, bootstrap
# arrays) — same reasoning as ../gaussian_process-interpolant/.gitignore.
# Scoped to this folder only, not the repo root.
saved_models/*

# Figures are regenerated by the pipeline scripts; keep the repo small.
figures/*.png

# results/ (comparison CSVs) are intentionally NOT ignored — small, and
# committing them documents what a given run produced, same convention as
# the GP side's gp_comparison_results_superset_*.csv files.

!.gitkeep
